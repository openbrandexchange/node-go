[Unit]
Description=Brand portal (Open Brand Exchange, node-go)
After=network-online.target
Wants=network-online.target

[Service]
User=obx
Group=obx
EnvironmentFile=/etc/node-go/node-go.env
ExecStart=/usr/local/bin/node-go serve
Restart=on-failure
RestartSec=3
# Running requests get 25 s to finish on stop; jobs resume after a restart.
TimeoutStopSec=40
LimitNOFILE=65536
MemoryMax=75%
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/node-go
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
