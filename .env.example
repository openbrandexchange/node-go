# Copy to .env next to docker-compose.yml and fill in. Only the first two are needed.
DOMAIN=images.yourbrand.example
ADMIN_EMAIL=you@yourbrand.example

# Recommended: generate once and keep it with your backups (openssl rand -base64 48).
# Without it a key is generated into the data volume on first start.
OBX_SECRET_KEY=
# Optional: choose the first-run setup code yourself (otherwise it is printed in the log).
OBX_SETUP_CODE=
# Optional: e-mail for invitations and download notifications.
# OBX_SMTP_URL=smtp://user:password@smtp.example.com:587
# OBX_MAIL_FROM=portal@yourbrand.example
# Optional: continuous database backup to a bucket (see docs/operations.md).
# LITESTREAM_REPLICA_URL=s3://your-bucket/portal-db
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# Optional: Prometheus metrics at /metrics, readable with this bearer token.
# OBX_METRICS_TOKEN=
