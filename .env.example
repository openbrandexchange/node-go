# Copy to .env next to docker-compose.yml and fill in.
OBX_DOMAIN=images.yourbrand.example
# Generate once and keep safe: openssl rand -base64 48
OBX_SECRET_KEY=
# Optional: choose the first-run setup code yourself (otherwise it is printed in the log).
OBX_SETUP_CODE=
# Optional: e-mail for invitations and download notifications.
# OBX_SMTP_URL=smtp://user:password@smtp.example.com:587
# OBX_MAIL_FROM=portal@yourbrand.example
